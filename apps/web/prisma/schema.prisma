generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENTIDADES PRINCIPAIS
// ============================================

model Rota {
  id          String   @id @default(cuid())
  descricao   String
  cor         String   @default("#2563EB")
  regiao      String?
  ordem       Int      @default(0)
  observacao  String?
  status      String   @default("Ativo")
  version     Int      @default(1)
  syncOrigin  String?
  deletedAt   DateTime?

  clientes    Cliente[]
  usuarioRotas UsuarioRota[]
  metas       Meta[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
  @@index([deletedAt])
  @@index([status])
  @@map("rotas")
}

model Cliente {
  id                String   @id @default(cuid())
  tipoPessoa        String   @default("Fisica")
  identificador     String   @unique
  nomeExibicao      String
  nomeCompleto      String?
  razaoSocial       String?
  cpf               String?
  cnpj              String?
  rg                String?
  inscricaoEstadual String?
  telefonePrincipal String
  email             String?
  contatos          Json?
  cep               String   @default("")
  logradouro        String   @default("")
  numero            String   @default("")
  complemento       String?
  bairro            String   @default("")
  cidade            String   @default("")
  estado            String   @default("")
  latitude          Float?
  longitude         Float?
  rotaId            String?
  status            String   @default("Ativo")
  version           Int      @default(1)
  syncOrigin        String?
  deletedAt         DateTime?

  rota              Rota?    @relation(fields: [rotaId], references: [id])
  locacoes          Locacao[]
  cobrancas         Cobranca[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([updatedAt])
  @@index([deletedAt])
  @@index([rotaId])
  @@index([status])
  @@map("clientes")
}

model TipoProduto {
  id        String    @id @default(cuid())
  nome      String    @unique
  produtos  Produto[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([updatedAt])
  @@map("tipos_produto")
}

model DescricaoProduto {
  id        String    @id @default(cuid())
  nome      String    @unique
  produtos  Produto[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([updatedAt])
  @@map("descricoes_produto")
}

model TamanhoProduto {
  id        String    @id @default(cuid())
  nome      String    @unique
  produtos  Produto[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([updatedAt])
  @@map("tamanhos_produto")
}

model Produto {
  id                String    @id @default(cuid())
  identificador     String    @unique
  numeroRelogio     String    @default("0")
  tipoId            String
  tipoNome          String
  descricaoId       String
  descricaoNome     String
  tamanhoId         String
  tamanhoNome       String
  codigoCH          String?
  codigoABLF        String?
  conservacao       String    @default("Boa")
  statusProduto     String    @default("Ativo")
  estabelecimento   String?
  observacao        String?
  version           Int       @default(1)
  syncOrigin        String?
  deletedAt         DateTime?

  tipo              TipoProduto     @relation(fields: [tipoId], references: [id])
  descricao         DescricaoProduto @relation(fields: [descricaoId], references: [id])
  tamanho           TamanhoProduto  @relation(fields: [tamanhoId], references: [id])
  locacoes          Locacao[]
  cobrancas         Cobranca[]
  historicoRelogio  HistoricoRelogio[]
  manutencoes       Manutencao[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([updatedAt])
  @@index([deletedAt])
  @@index([statusProduto])
  @@map("produtos")
}

model Estabelecimento {
  id        String    @id @default(cuid())
  nome      String    @unique
  endereco  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([updatedAt])
  @@map("estabelecimentos")
}

model Locacao {
  id                  String    @id @default(cuid())
  clienteId           String
  clienteNome         String
  produtoId           String
  produtoIdentificador String
  produtoTipo         String
  dataLocacao         DateTime
  dataFim             DateTime?
  formaPagamento      String    // Periodo, PercentualPagar, PercentualReceber
  numeroRelogio       String    @default("0")
  precoFicha          Decimal   @default(0) @db.Decimal(12, 2)
  percentualEmpresa   Decimal   @default(0) @db.Decimal(12, 2)
  percentualCliente   Decimal   @default(0) @db.Decimal(12, 2)
  valorFixo           Decimal?  @db.Decimal(12, 2)
  periodicidade       String?   // Semanal, Quinzenal, Mensal
  dataPrimeiraCobranca DateTime?
  observacoes         String?
  status              String    @default("Ativa")
  ultimaLeituraRelogio Decimal? @db.Decimal(12, 2)
  trocaPano           Boolean   @default(false)
  version             Int       @default(1)
  syncOrigin          String?
  deletedAt           DateTime?

  cliente             Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  produto             Produto   @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  cobrancas           Cobranca[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([updatedAt])
  @@index([deletedAt])
  @@index([clienteId])
  @@index([produtoId])
  @@index([status])
  @@map("locacoes")
}

model Cobranca {
  id                    String    @id @default(cuid())
  locacaoId             String
  clienteId             String
  clienteNome           String
  produtoId             String?
  produtoIdentificador  String
  dataInicio            DateTime
  dataFim               DateTime
  dataPagamento         DateTime?
  dataVencimento        DateTime?
  relogioAnterior       Decimal   @default(0) @db.Decimal(12, 2)
  relogioAtual          Decimal   @default(0) @db.Decimal(12, 2)
  fichasRodadas         Decimal   @default(0) @db.Decimal(12, 2)
  valorFicha            Decimal   @default(0) @db.Decimal(12, 2)
  totalBruto            Decimal   @default(0) @db.Decimal(12, 2)
  descontoPartidasQtd   Decimal?  @db.Decimal(12, 2)
  descontoPartidasValor Decimal?  @db.Decimal(12, 2)
  descontoDinheiro      Decimal?  @db.Decimal(12, 2)
  percentualEmpresa     Decimal   @default(0) @db.Decimal(12, 2)
  subtotalAposDescontos Decimal   @default(0) @db.Decimal(12, 2)
  valorPercentual       Decimal   @default(0) @db.Decimal(12, 2)
  totalClientePaga      Decimal   @default(0) @db.Decimal(12, 2)
  valorRecebido         Decimal   @default(0) @db.Decimal(12, 2)
  saldoDevedorGerado    Decimal   @default(0) @db.Decimal(12, 2)
  status                String    @default("Pendente")
  formaPagamento        String    @default("Periodo")
  observacao            String?
  version               Int       @default(1)
  syncOrigin            String?
  deletedAt             DateTime?

  locacao               Locacao             @relation(fields: [locacaoId], references: [id], onDelete: Cascade)
  cliente               Cliente             @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  produto               Produto?            @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  pagamentos            PagamentoCobranca[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([updatedAt])
  @@index([deletedAt])
  @@index([clienteId])
  @@index([locacaoId])
  @@index([status])
  @@index([status, dataVencimento])
  @@index([deletedAt, status])
  @@map("cobrancas")
}

model PagamentoCobranca {
  id              String    @id @default(cuid())
  cobrancaId      String
  valor           Decimal   @db.Decimal(12, 2)
  formaPagamento  String    @default("Pix")  // Dinheiro, Pix, Cartao, Transferencia
  dataPagamento   DateTime
  observacao      String?
  usuarioId       String?
  usuarioNome     String?
  syncOrigin      String?

  cobranca        Cobranca  @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
  @@index([cobrancaId])
  @@map("pagamentos_cobranca")
}

// ============================================
// USUARIOS E PERMISSOES
// ============================================

model Usuario {
  id                    String    @id @default(cuid())
  nome                  String
  email                 String    @unique
  senha                 String
  cpf                   String?
  telefone              String?
  tipoPermissao         String    @default("AcessoControlado")
  permissoesWeb         Json      @default("{}")
  permissoesMobile      Json      @default("{}")
  rotasPermitidas       Json      @default("[]")
  status                String    @default("Ativo")
  bloqueado             Boolean   @default(false)
  dataUltimoAcesso      String?
  ultimoAcessoDispositivo String?
  version               Int       @default(1)
  deletedAt             DateTime?

  rotasPermitidasRel    UsuarioRota[]
  notificacoes          Notificacao[]
  logsAuditoria         LogAuditoria[]
  sessoes               Sessao[]
  metas                 Meta[]
  dispositivos          Dispositivo[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([updatedAt])
  @@index([deletedAt])
  @@index([status])
  @@map("usuarios")
}

model UsuarioRota {
  id        String   @id @default(cuid())
  usuarioId String
  rotaId    String

  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rota      Rota     @relation(fields: [rotaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, rotaId])
  @@map("usuarios_rotas")
}

// ============================================
// TABELAS DE SISTEMA
// ============================================

model HistoricoRelogio {
  id          String    @id @default(cuid())
  produtoId   String
  relogioAnterior String
  relogioNovo String
  motivo      String?
  observacao  String?
  usuarioId   String?
  usuarioNome String?
  syncOrigin  String?

  produto     Produto   @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
  @@index([produtoId])
  @@map("historico_relogio")
}

model Manutencao {
  id          String    @id @default(cuid())
  produtoId   String
  produtoIdentificador String?
  tipo        String    // preventiva, corretiva, troca_pano, etc.
  descricao   String
  dataInicio  DateTime
  dataFim     DateTime?
  custo       Decimal   @default(0) @db.Decimal(12, 2)
  status      String    @default("EmAndamento")
  observacao  String?
  usuarioId   String?
  usuarioNome String?
  syncOrigin  String?

  produto     Produto   @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
  @@index([produtoId])
  @@index([status])
  @@map("manutencoes")
}

model Notificacao {
  id        String    @id @default(cuid())
  usuarioId String
  tipo      String    // cobranca_vencida, saldo_devedor, info
  titulo    String
  mensagem  String
  lida      Boolean   @default(false)
  link      String?

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([usuarioId])
  @@index([lida])
  @@index([usuarioId, lida])
  @@map("notificacoes")
}

model Meta {
  id          String    @id @default(cuid())
  nome        String
  tipo        String    // receita, cobrancas, adimplencia
  valorMeta   Decimal   @db.Decimal(12, 2)
  valorAtual  Decimal   @default(0) @db.Decimal(12, 2)
  dataInicio  DateTime
  dataFim     DateTime
  rotaId      String?
  status      String    @default("ativa")
  criadoPor   String?

  rota        Rota?     @relation(fields: [rotaId], references: [id], onDelete: SetNull)
  usuario     Usuario?  @relation(fields: [criadoPor], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
  @@map("metas")
}

model LogAuditoria {
  id            String    @id @default(cuid())
  usuarioId     String?
  acao          String
  entidade      String
  entidadeId    String?
  entidadeNome  String?
  detalhes      Json?
  antes         Json?
  depois        Json?
  ip            String?
  severidade    String    @default("info")
  origem        String    @default("web")

  usuario       Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([entidade])
  @@index([createdAt])
  @@index([entidade, createdAt])
  @@map("logs_auditoria")
}

model Sessao {
  id          String    @id @default(cuid())
  usuarioId   String
  token       String    @unique
  dispositivo String    @default("Web")
  ip          String?
  expiraEm    DateTime

  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessoes")
}

model Dispositivo {
  id              String    @id @default(cuid())
  nome            String
  deviceKey       String    @unique
  senha           String
  ativo           Boolean   @default(false)
  ultimoSync      DateTime?
  usuarioId       String?
  rotasPermitidas Json      @default("[]")

  usuario         Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  syncCursors     DeviceSyncCursor[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([usuarioId])
  @@map("dispositivos")
}

// ============================================
// SINCRONIZACAO
// ============================================

/// Tracks every mutation for sync consumers.
/// Pull endpoints query this table for changes since a device's last sync cursor.
model SyncLog {
  id          String   @id @default(cuid())
  entidade    String   // cliente, produto, locacao, cobranca, etc.
  entidadeId  String
  operacao    String   // create, update, delete
  dados       Json?    // full record snapshot after mutation
  updatedAt   DateTime // the entity updatedAt at time of change

  createdAt   DateTime @default(now())

  @@index([entidade, updatedAt])
  @@index([updatedAt])
  @@index([entidadeId])
  @@map("sync_logs")
}

/// Tracks sync progress per device per entity.
/// Each device maintains a cursor (lastSyncAt) per entity type.
model DeviceSyncCursor {
  id            String   @id @default(cuid())
  dispositivoId String
  entidade      String
  lastSyncAt    DateTime

  dispositivo   Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  updatedAt     DateTime    @updatedAt

  @@unique([dispositivoId, entidade])
  @@index([dispositivoId])
  @@map("device_sync_cursors")
}
